{
  "name": "Freight AI - WhatsApp Trip Creation (Text + Voice)",
  "nodes": [
    {
      "parameters": {},
      "id": "whatsapp-trigger",
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "notes": "Credential: WhatsApp TRIGGER (OAuth2) \u2014 App ID + App Secret. NOT the same as Send credential."
    },
    {
      "parameters": {
        "jsCode": "const msg = $input.first().json;\n\n// n8n WhatsApp Trigger already unwraps Meta webhook to value-level fields.\n// Also support raw Meta webhook shape: entry[0].changes[0].value\nconst value =\n  msg.messages || msg.contacts || msg.metadata\n    ? msg\n    : msg.entry?.[0]?.changes?.[0]?.value || msg;\n\nconst message = (value.messages || [])[0] || {};\nconst interactive = message.interactive || {};\nconst buttonId =\n  interactive.button_reply?.id ||\n  interactive.list_reply?.id ||\n  null;\n\nconst text =\n  message.text?.body ||\n  (typeof message.text === 'string' ? message.text : null) ||\n  null;\n\nconst mediaId =\n  message.audio?.id ||\n  message.voice?.id ||\n  null;\n\nconst interactiveReply = buttonId ? String(buttonId).toUpperCase() : null;\n\nlet route = 'TEXT';\nif (interactiveReply === 'CREATE') route = 'CREATE';\nelse if (interactiveReply === 'CANCEL') route = 'CANCEL';\nelse if (interactiveReply === 'EDIT') route = 'EDIT';\nelse if (interactiveReply) route = 'OTHER_BUTTON';\nelse if ((message.type === 'audio' || message.type === 'voice') && mediaId) route = 'AUDIO';\n\nreturn [{\n  json: {\n    sender_phone: message.from || null,\n    message_id: message.id || null,\n    message_type: message.type || null,\n    text,\n    media_id: mediaId,\n    timestamp: message.timestamp || null,\n    interactive_reply: interactiveReply,\n    route,\n  },\n}];\n"
      },
      "id": "normalize",
      "name": "Normalize Incoming Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "is-interactive",
              "leftValue": "={{ $json.interactive_reply }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-interactive",
      "name": "IF Interactive Reply",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://49b2-103-248-87-67.ngrok-free.app/v1/extract-trip-intent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "ngrok-skip-browser-warning",
              "value": "true"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: ($json.text || ''), timezone: 'Asia/Kolkata' }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "extract-intent",
      "name": "Extract Trip Intent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://49b2-103-248-87-67.ngrok-free.app/v1/trip-drafts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "ngrok-skip-browser-warning",
              "value": "true"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  sender_phone: $('Normalize Incoming Message').item.json.sender_phone,\n  source_message_id: $('Normalize Incoming Message').item.json.message_id,\n  raw_text: $('Normalize Incoming Message').item.json.text,\n  extraction: $json\n}) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "create-draft",
      "name": "POST Trip Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        180
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "is-missing",
              "leftValue": "={{ $json.status }}",
              "rightValue": "MISSING_INFO",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-missing",
      "name": "IF Missing Info",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1340,
        180
      ]
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "1256431730893371",
        "recipientPhoneNumber": "={{ $('Normalize Incoming Message').item.json.sender_phone }}",
        "textBody": "={{ $json.next_question }}"
      },
      "id": "ask-missing",
      "name": "Ask Missing Field",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [
        1560,
        80
      ],
      "notes": "Credential: WhatsApp Business Cloud API (Access Token + Business Account ID)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/1256431730893371/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "whatsAppApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  messaging_product: 'whatsapp',\n  to: String($('Normalize Incoming Message').item.json.sender_phone || '').replace(/^\\+/, ''),\n  type: 'interactive',\n  interactive: {\n    type: 'button',\n    body: { text: String($json.confirmation_summary || 'Trip draft ready. Confirm karein.').slice(0, 1024) },\n    action: {\n      buttons: [\n        { type: 'reply', reply: { id: 'CREATE', title: 'CREATE' } },\n        { type: 'reply', reply: { id: 'EDIT', title: 'EDIT' } },\n        { type: 'reply', reply: { id: 'CANCEL', title: 'CANCEL' } }\n      ]\n    }\n  }\n}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "send-confirmation",
      "name": "Send Confirmation Buttons",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        280
      ],
      "notes": "n8n WhatsApp node cannot send reply buttons. Uses Meta Graph API interactive buttons. Credential: WhatsApp Business Cloud API (same Access Token)."
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "route-create",
                    "leftValue": "={{ $json.route }}",
                    "rightValue": "CREATE",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "CREATE"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "route-cancel",
                    "leftValue": "={{ $json.route }}",
                    "rightValue": "CANCEL",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "CANCEL"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "route-action",
      "name": "Route CREATE/CANCEL",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        900,
        420
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://49b2-103-248-87-67.ngrok-free.app/v1/trip-drafts/open?sender_phone={{ $json.sender_phone }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "ngrok-skip-browser-warning",
              "value": "true"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "resolve-draft-create",
      "name": "Resolve Open Draft (CREATE)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        360
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://49b2-103-248-87-67.ngrok-free.app/v1/trip-drafts/open?sender_phone={{ $json.sender_phone }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
