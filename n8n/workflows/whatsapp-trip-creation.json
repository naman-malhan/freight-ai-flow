        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  sender_phone: $('Normalize Incoming Message').item.json.sender_phone,\n  source_message_id: $('Normalize Incoming Message').item.json.message_id\n}) }}",
        "options": {
