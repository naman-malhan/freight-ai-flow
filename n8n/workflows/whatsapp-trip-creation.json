    {
      "parameters": {},
      "id": "whatsapp-trigger",
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "notes": "Credential: WhatsApp TRIGGER (OAuth2) — App ID + App Secret. NOT the same as Send credential."
    },
    {
      "parameters": {
        "jsCode": "const msg = $input.first().json;\n\n// n8n WhatsApp Trigger unwraps Meta webhook; also support raw entry[0].changes[0].value\nconst value =\n  msg.messages || msg.contacts || msg.metadata\n    ? msg\n    : msg.entry?.[0]?.changes?.[0]?.value || msg;\n\nconst messagesRaw = value.messages || msg.messages || [];\nconst message = Array.isArray(messagesRaw)\n  ? (messagesRaw[0] || {})\n  : (messagesRaw || {});\n\n// Some n8n versions put message fields on the item root\nconst root = (!message.id && (msg.type || msg.from || msg.interactive)) ? msg : message;\n\nconst interactive = root.interactive || message.interactive || msg.interactive || {};\nlet buttonId =\n  interactive.button_reply?.id ||\n  interactive.list_reply?.id ||\n  interactive.button_reply?.title ||\n  root.button_reply?.id ||\n  message.button_reply?.id ||\n  msg.button_reply?.id ||\n  root.button?.payload ||\n  null;\n\nlet text =\n  root.text?.body ||\n  message.text?.body ||\n  (typeof root.text === 'string' ? root.text : null) ||\n  (typeof message.text === 'string' ? message.text : null) ||\n  null;\n\nconst mediaId =\n  root.audio?.id ||\n  message.audio?.id ||\n  root.voice?.id ||\n  message.voice?.id ||\n  null;\n\nconst textUpper = String(text || '').trim().toUpperCase();\nlet interactiveReply = buttonId ? String(buttonId).trim().toUpperCase() : null;\n\n// Fallback: plain text CREATE/CANCEL/EDIT (some clients / trigger shapes)\nif (!interactiveReply && ['CREATE', 'CANCEL', 'EDIT'].includes(textUpper)) {\n  interactiveReply = textUpper;\n  text = null;\n}\n\n// Fallback: type interactive/button but id only in title\nif (!interactiveReply && (root.type === 'interactive' || root.type === 'button' || message.type === 'interactive')) {\n  const title = (\n    interactive.button_reply?.title ||\n    interactive.list_reply?.title ||\n    root.button?.text ||\n    ''\n  ).toString().trim().toUpperCase();\n  if (['CREATE', 'CANCEL', 'EDIT'].includes(title)) interactiveReply = title;\n}\n\nlet route = 'TEXT';\nif (interactiveReply === 'CREATE') route = 'CREATE';\nelse if (interactiveReply === 'CANCEL') route = 'CANCEL';\nelse if (interactiveReply === 'EDIT') route = 'EDIT';\nelse if (interactiveReply) route = 'OTHER_BUTTON';\nelse if ((root.type === 'audio' || root.type === 'voice' || message.type === 'audio' || message.type === 'voice') && mediaId) route = 'AUDIO';\n\nreturn [{\n  json: {\n    sender_phone: root.from || message.from || msg.from || null,\n    message_id: root.id || message.id || msg.id || null,\n    message_type: root.type || message.type || msg.type || null,\n    text,\n    media_id: mediaId,\n    timestamp: root.timestamp || message.timestamp || null,\n    interactive_reply: interactiveReply,\n    route,\n  },\n}];\n"
      },
