              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-audio",
      "name": "IF Audio Message",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        900,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://49b2-103-248-87-67.ngrok-free.app/v1/whatsapp/webhook",
        "sendHeaders": true,
        "headerParameters": {
