      "notes": "Credential: WhatsApp Business Cloud API"
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "1256431730893371",
        "recipientPhoneNumber": "={{ $('Normalize Incoming Message').item.json.sender_phone }}",
        "textBody": "={{ 'Draft #D-' + $json.draft_id + ' cancel ho gaya.' }}"
      },
      "id": "send-cancelled",
      "name": "Send Cancelled",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [
        1560,
