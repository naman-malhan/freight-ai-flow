DATABASE_URL=postgresql+asyncpg://freight:freight@localhost:5432/freight_ai
DATABASE_URL_SYNC=postgresql+psycopg2://freight:freight@localhost:5432/freight_ai
APP_TIMEZONE=Asia/Kolkata
DRAFT_EXPIRY_HOURS=24
# Comma-separated required optional fields override (defaults in company config)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Primary STT: local faster-whisper (free, open-source)
FASTER_WHISPER_ENABLED=true
FASTER_WHISPER_MODEL=large-v3
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8

# Fallback STT: Groq cloud (used only if local fails)
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
